# ------------------------------------------------------------------
# MedFácil — variáveis de ambiente (copie para .env e ajuste)
# NUNCA versione o arquivo .env real.
# ------------------------------------------------------------------

# Conexão PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medfacil?schema=public"

# Segredo do JWT de acesso (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres"

# Validade dos tokens
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# URL pública da aplicação (validação de origem/CSRF e links).
# Também decide, NO BUILD, se HSTS e "upgrade-insecure-requests" são ativados:
# https:// (ou vazio) → ativados · http:// → desativados (produção local/CI).
APP_URL="http://localhost:3000"

# Modo demonstração: exibe na tela o link de redefinição de senha
# (em produção real o link seria enviado por e-mail). Use "false" em deploy público.
DEMO_SHOW_RESET_LINK="true"

# Credenciais do administrador criado pelo seed
SEED_ADMIN_EMAIL="admin@medfacil.demo"
SEED_ADMIN_PASSWORD="Admin@12345"

# Multiplicador dos limites de requisição (1 = estrito). Use 20 apenas para testes automatizados.
RATE_LIMIT_MULTIPLIER=1

# SEO: a loja é fictícia, então por padrão não é indexada. "true" libera robots/meta.
ALLOW_INDEXING="false"
